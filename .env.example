# CommunityOS environment template
# Copy to .env and fill values. Never commit real secrets.

# Database (Supabase Postgres / local PostGIS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/communityos?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/communityos?schema=public"

# API
API_HOST="0.0.0.0"
API_PORT="4000"
NODE_ENV="development"
# Comma-separated browser origins allowed to call the Fastify API
CORS_ORIGIN="http://localhost:3000"

# Auth (Supabase)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Web (public) — leave empty to use same-origin Next.js /v1 BFF (required on Vercel)
# Set only when calling a separate Fastify process locally:
# NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Demo geography dataset (Jaffar-e-Tayyar) — keep 1 until Supabase is seeded
COMMUNITYOS_DEMO_DATA="1"
